        <mxCell id="c14" value="" style="rounded=1;fillColor=#FEE2E2;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="1852" y="410" width="22" height="18" as="geometry"/></mxCell>
        <mxCell id="c15" value="Problema de origen (formato o dato sucio)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1882" y="407" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="c16" value="" style="rounded=1;fillColor=#F1F5F9;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="1852" y="436" width="22" height="18" as="geometry"/></mxCell>
        <mxCell id="c17" value="Viene en el archivo pero la app no lo usa" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1882" y="433" width="370" height="24" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b style='font-size:14px'&gt;Cómo se unieron (llaves)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;🔑 VIN&lt;/b&gt; → une RM_CONTRATOS.csv con Provisiones, el RM de la contraparte comercial y 3PC. Se normaliza: sin espacios y en mayúsculas.&lt;br&gt;&lt;br&gt;&lt;b&gt;CHASIS&lt;/b&gt; = últimos 7 caracteres del VIN (ya no se escribe a mano).&lt;br&gt;&lt;br&gt;&lt;b&gt;🔗 CDB&lt;/b&gt; → une RM_CONTRATOS.csv con Contactos y BBDD CLIENTES CM. Se limpia el “.0” y los espacios. Hay dos: CDB COMERCIAL (Comercial) y CDB FLOTA (Operaciones y correos).&lt;br&gt;&lt;br&gt;&lt;b&gt;ID&lt;/b&gt; → cada fila del RM es un contrato; el contrato actual de un VIN es el de ID más alto.&lt;br&gt;&lt;br&gt;&lt;b&gt;AÑO - MES + VIN&lt;/b&gt; → llave de Provisiones (evita duplicar un mes).&lt;br&gt;&lt;br&gt;&lt;b&gt;Nombre de la empresa&lt;/b&gt; → solo se usa para sugerir candidatos cuando un VIN no existe en RM_CONTRATOS (Provisiones y 3PC).&lt;br&gt;&lt;br&gt;&lt;b&gt;Valores normalizados al cargar:&lt;/b&gt; industria, forma de contrato, estado comercial, estado del CM, JustTime.&lt;br&gt;&lt;br&gt;&lt;b&gt;Columnas calculadas:&lt;/b&gt; CHASIS, TÉRMINO CONTRATO, ETAPA GESTIÓN, TIPO DE FACTURACION." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=12;fontColor=#334155;shadow=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1840" y="482" width="420" height="540" as="geometry"/></mxCell>
        <mxCell id="e19" value="sobrescribe columnas autorizadas&lt;br&gt;(por VIN)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#1E293B;fontFamily=Segoe UI;strokeColor=#1C3F6E;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="ms_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e20" value="solo filas nuevas (AÑO - MES + VIN)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#1E293B;fontFamily=Segoe UI;strokeColor=#0E7490;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sp2_t" target="pv_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e21" value="&lt;b&gt;VIN · N : 1&lt;/b&gt;&lt;br&gt;al guardar actualiza:&lt;br&gt;Plan → TIPO DE SERVICIO&lt;br&gt;Cantidad de Meses → DURACIÓN&lt;br&gt;AÑO - MES → PERIODO INTERNO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#1E293B;fontFamily=Segoe UI;strokeColor=#EA580C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pv_r2" target="ms_r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e22" value="VIN huérfano: sugiere cliente&lt;br&gt;por nombre (RAZÓN SOCIAL)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#1E293B;fontFamily=Segoe UI;strokeColor=#7C3AED;dashed=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pv_r3" target="ms_r5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e23" value="&lt;b&gt;alta de unidades nuevas&lt;/b&gt;&lt;br&gt;(VIN + datos del cliente)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#1E293B;fontFamily=Segoe UI;strokeColor=#A16207;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="nv_t" target="ms_r12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e24" value="&lt;b&gt;CDB · 1 : N&lt;/b&gt;&lt;br&gt;contactos de la empresa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#1E293B;fontFamily=Segoe UI;strokeColor=#16A34A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=none;" edge="1" parent="1" source="ms_r7" target="ct_r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e25" value="&lt;b&gt;CDB · N : 1&lt;/b&gt;&lt;br&gt;dirección, comuna, respaldo RS/RUT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#1E293B;fontFamily=Segoe UI;strokeColor=#16A34A;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ms_r7" target="bd_r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e26" value="&lt;b&gt;VIN · 1 : 1&lt;/b&gt;&lt;br&gt;actualiza el bloque CM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#1E293B;fontFamily=Segoe UI;strokeColor=#4D7C0F;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="pc_r1" target="ms_r30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e27" value="VIN con CM que no vienen&lt;br&gt;en el 3PC del mes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#1E293B;fontFamily=Segoe UI;strokeColor=#4D7C0F;dashed=1;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="pc_t" target="o3_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e28" value="ESTADO DEL CM = Expired" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#1E293B;fontFamily=Segoe UI;strokeColor=#64748B;dashed=1;exitX=1;exitY=0.5;entryX=0.25;entryY=0;" edge="1" parent="1" source="ms_r35" target="o3_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#1E293B;fontFamily=Segoe UI;strokeColor=#64748B;strokeWidth=1.5;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ms_t" target="o1_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
