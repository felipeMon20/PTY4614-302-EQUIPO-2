  <diagram id="2---como-se-usan-en-la-app" name="2 - Como se usan en la app">
    <mxGraphModel dx="1900" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1926" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b&gt;Modelo de datos · 2. Cómo se usan y se conectan en la app&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontColor=#0B2A4A;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1400" height="44" as="geometry"/></mxCell>
        <mxCell id="c2" value="RM_CONTRATOS.csv es la base central (Registro Maestro; cada fila es un contrato con su ID): cada fuente se une a ella por VIN o por CDB, y la app normaliza nombres y valores al cargar" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#64748B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1800" height="30" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b style='font-size:13px'&gt;RM_REPORTE_CONECTADOS.xlsx · Sincronización (temporal)&lt;/b&gt;&lt;br&gt;Merge por &lt;b&gt;VIN_CLEAN&lt;/b&gt;. Solo pasan las columnas autorizadas. Renombra OPERACION→INDUSTRIA, FECHA INICIO/TÉRMINO FACTURACIÓN→INICIO/TERMINO, PAGO CM MM/AAAA→PAGO CM. ETAPA GESTIÓN del RM se ignora (se conserva la local).&lt;br&gt;&lt;i&gt;Hoy RM_CONTRATOS.csv es el Registro Maestro de la app. Esta sincronización es solo para desarrollo y se oculta al entregar.&lt;/i&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#1C3F6E;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=12;fontColor=#334155;shadow=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="820" y="105" width="450" height="120" as="geometry"/></mxCell>
        <mxCell id="ms_t" value="RM_CONTRATOS.csv · REGISTRO MAESTRO (Comercial)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=34;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;rounded=1;arcSize=3;fillColor=#0B2A4A;strokeColor=#0B2A4A;fontColor=#FFFFFF;fontSize=13;swimlaneFillColor=#FFFFFF;shadow=1;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="820" y="270" width="450" height="1290" as="geometry"/></mxCell>
