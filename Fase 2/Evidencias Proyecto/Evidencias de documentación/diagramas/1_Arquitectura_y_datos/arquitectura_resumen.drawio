<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram id="arquitectura-resumen" name="Arquitectura en una página">
    <mxGraphModel dx="1400" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="740" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="&lt;b&gt;Gestor SSCC&lt;/b&gt; · arquitectura en una página" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontColor=#0B2A4A;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="sub" value="Programa de escritorio que trabaja sobre archivos de SharePoint: sin servidor propio ni base de datos externa" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1100" height="28" as="geometry"/></mxCell>
        <mxCell id="u" value="① Quién la usa" style="swimlane;rounded=1;arcSize=5;startSize=34;fillColor=#1C6BBA;swimlaneFillColor=#EEF4FB;strokeColor=#1C6BBA;fontColor=#FFFFFF;fontSize=14;fontStyle=1;html=1;whiteSpace=wrap;shadow=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="330" as="geometry"/></mxCell>
        <mxCell id="actor" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#1C6BBA;strokeColor=#0B2A4A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="120" y="150" width="40" height="70" as="geometry"/></mxCell>
        <mxCell id="u_txt" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Equipo de gestión de flota&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Comercial, Operaciones y Finanzas.&lt;br&gt;&lt;br&gt;• Buscan y editan clientes, camiones y contratos&lt;br&gt;• Generan facturación manual&lt;br&gt;• Envían correos a clientes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1C6BBA;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="55" y="245" width="190" height="170" as="geometry"/></mxCell>
        <mxCell id="a" value="② La aplicación · Gestor SSCC (.exe en cada PC)" style="swimlane;rounded=1;arcSize=5;startSize=34;fillColor=#1C3F6E;swimlaneFillColor=#FFFFFF;strokeColor=#1C3F6E;fontColor=#FFFFFF;fontSize=14;fontStyle=1;html=1;whiteSpace=wrap;shadow=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="310" y="100" width="520" height="330" as="geometry"/></mxCell>
        <mxCell id="a_pant" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Pantallas&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Dashboard propio de la app · Clientes y Flota · Comercial · Operaciones · Ingresos y Conciliación (provisiones, CM, facturación manual, JustTime) · Administración" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1C6BBA;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="325" y="144" width="490" height="112" as="geometry"/></mxCell>
        <mxCell id="a_motor" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Por dentro, de forma automática&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Trabaja en memoria: búsquedas y filtros instantáneos&lt;br&gt;Guardado seguro: respaldo antes de guardar&lt;br&gt;Cada cambio queda en el Historial&lt;br&gt;Vigilante: avisa si alguien cambia un archivo por fuera&lt;br&gt;Pausa con aviso si un archivo está ocupado&lt;br&gt;Genera sus propios Excel y PDF (facturación, instalaciones)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#2E9E5B;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="325" y="268" width="490" height="150" as="geometry"/></mxCell>
        <mxCell id="s" value="③ SharePoint · carpeta compartida del equipo" style="swimlane;rounded=1;arcSize=5;startSize=34;fillColor=#D97706;swimlaneFillColor=#FFFBF3;strokeColor=#D97706;fontColor=#FFFFFF;fontSize=14;fontStyle=1;html=1;whiteSpace=wrap;shadow=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="880" y="100" width="480" height="210" as="geometry"/></mxCell>
        <mxCell id="s_datos" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Datos&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Archivos CSV y Excel:&lt;br&gt;• Registro Maestro&lt;br&gt;• Provisiones y facturación&lt;br&gt;• Contactos y correos&lt;br&gt;• Historial de cambios" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#FFF4E0;strokeColor=#D97706;strokeWidth=2;fontSize=11;fontColor=#1E293B;verticalAlign=top;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="895" y="144" width="215" height="156" as="geometry"/></mxCell>
        <mxCell id="s_upd" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Carpeta «Codigo - APP»&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Zip de la aplicación y archivo version.json.&lt;br&gt;&lt;br&gt;La app avisa cuando hay una versión nueva y se actualiza con un clic." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fontColor=#1E293B;fontFamily=Segoe UI;dashed=1;" vertex="1" parent="1"><mxGeometry x="1125" y="144" width="220" height="156" as="geometry"/></mxCell>
        <mxCell id="r" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Respaldos en el propio PC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Copia antes de cada guardado (las últimas 10) y respaldo completo automático los viernes. Se restauran desde Configuración." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fontColor=#1E293B;fontFamily=Segoe UI;dashed=1;" vertex="1" parent="1"><mxGeometry x="880" y="325" width="480" height="105" as="geometry"/></mxCell>
        <mxCell id="sv" value="④ Servicios que usa" style="swimlane;rounded=1;arcSize=5;startSize=34;fillColor=#0F766E;swimlaneFillColor=#F2FBFA;strokeColor=#0F766E;fontColor=#FFFFFF;fontSize=14;fontStyle=1;html=1;whiteSpace=wrap;shadow=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="310" y="455" width="1050" height="128" as="geometry"/></mxCell>
        <mxCell id="sv_o" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Outlook del computador&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Envía los correos con la cuenta de la persona. La app no guarda contraseñas." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="325" y="497" width="500" height="75" as="geometry"/></mxCell>
        <mxCell id="sv_u" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Valor de la UF&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Facturación Manual consulta la UF del día en internet (único acceso externo)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="845" y="497" width="500" height="75" as="geometry"/></mxCell>
        <mxCell id="inst" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Cómo se instala&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Como un programa de Windows (.exe, empaquetado con PyInstaller): no requiere instalar Python ni ningún servidor." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="455" width="220" height="128" as="geometry"/></mxCell>
        <mxCell id="seg" value="⑤ Seguridad y límites" style="swimlane;rounded=1;arcSize=5;startSize=34;fillColor=#0B2A4A;swimlaneFillColor=#F4F7FB;strokeColor=#0B2A4A;fontColor=#FFFFFF;fontSize=14;fontStyle=1;html=1;whiteSpace=wrap;shadow=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="608" width="1320" height="112" as="geometry"/></mxCell>
        <mxCell id="g1" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Sin servidor propio&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Todo vive en archivos de SharePoint." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF0F8;strokeColor=#0B2A4A;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="55" y="650" width="310" height="60" as="geometry"/></mxCell>
        <mxCell id="g2" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Permisos de SharePoint&lt;/font&gt;&lt;/b&gt;&lt;br&gt;La app usa solo lo que cada persona ya puede hacer." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF0F8;strokeColor=#0B2A4A;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="380" y="650" width="310" height="60" as="geometry"/></mxCell>
        <mxCell id="g3" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Correo con cuenta propia&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Sin servidor de correo ni credenciales en la app." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF0F8;strokeColor=#0B2A4A;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="705" y="650" width="310" height="60" as="geometry"/></mxCell>
        <mxCell id="g4" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Límite conocido&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Dos guardados casi simultáneos pueden crear una copia de conflicto de OneDrive." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#D97706;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1030" y="650" width="315" height="60" as="geometry"/></mxCell>
        <mxCell id="e1" value="usa" style="endArrow=block;endFill=1;html=1;strokeColor=#1C6BBA;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#1C6BBA;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;" edge="1" parent="1" source="u" target="a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="lee y guarda" style="endArrow=block;endFill=1;html=1;strokeColor=#2E9E5B;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#2E9E5B;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;startArrow=block;startFill=1;" edge="1" parent="1" source="a" target="s"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="copia antes de guardar" style="endArrow=block;endFill=1;html=1;strokeColor=#D97706;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#D97706;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;dashed=1;" edge="1" parent="1" source="a" target="r"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="se conecta" style="endArrow=block;endFill=1;html=1;strokeColor=#0F766E;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#0F766E;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;dashed=1;" edge="1" parent="1" source="a" target="sv"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
