        <mxCell id="t6" value="&lt;b&gt;SharePoint / OneDrive&lt;/b&gt; · comparte los archivos" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;align=left;spacingLeft=12;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1575" y="1014" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t7" value="&lt;b&gt;Internet&lt;/b&gt; · solo para consultar la UF" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;align=left;spacingLeft=12;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1275" y="1072" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t8" value="&lt;b&gt;Outlook&lt;/b&gt; · envío de correos" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;align=left;spacingLeft=12;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1575" y="1072" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t9" value="&lt;b&gt;Watchdog&lt;/b&gt; · el “vigilante” de archivos" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;align=left;spacingLeft=12;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1275" y="1130" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t10" value="&lt;b&gt;Programa .exe&lt;/b&gt; · se abre sin instalar Python" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;align=left;spacingLeft=12;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1575" y="1130" width="290" height="50" as="geometry" />
        </mxCell>

        <!-- FLECHAS -->
        <mxCell id="e_usa" value="usa" style="endArrow=block;endFill=1;html=1;strokeColor=#1C6BBA;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#1C6BBA;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.307;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="usuarios" target="pantallas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_conecta" value="se conecta" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;strokeColor=#0F766E;strokeWidth=2;dashed=1;fontSize=11;fontStyle=1;fontColor=#0F766E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.388;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pantallas" target="externos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_avisa" value="avisa" style="endArrow=block;endFill=1;html=1;strokeColor=#D97706;strokeWidth=2;dashed=1;fontSize=11;fontStyle=1;fontColor=#D97706;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.342;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="datos" target="m_vigilante">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
