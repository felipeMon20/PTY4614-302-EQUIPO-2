          <mxGeometry relative="1" as="geometry" />
        </mxCell>


        <!-- ADICIONES: tecnologías extra -->
        <mxCell id="t11" value="&lt;b&gt;PyInstaller&lt;/b&gt; · empaqueta todo en un solo programa" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;align=left;spacingLeft=12;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1275" y="1188" width="290" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t12" value="&lt;b&gt;Windows COM&lt;/b&gt; · permite pedirle a Outlook que envíe" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;align=left;spacingLeft=12;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1575" y="1188" width="290" height="50" as="geometry" />
        </mxCell>

        <!-- ⑧ SEGURIDAD -->
        <mxCell id="seg" value="⑧ SEGURIDAD Y LÍMITES · todo dentro de SharePoint, sin servidores propios" style="swimlane;rounded=1;arcSize=4;startSize=40;fillColor=#0B2A4A;swimlaneFillColor=#F4F7FB;strokeColor=#0B2A4A;fontColor=#FFFFFF;fontSize=15;fontStyle=1;html=1;whiteSpace=wrap;shadow=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="1290" width="1180" height="330" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Sin servidor ni base de datos externa&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Todo vive en archivos de la carpeta de SharePoint que el equipo ya usa. La aplicación corre en el computador de cada persona y no hay ningún servidor propio ni puertos abiertos." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF0F8;strokeColor=#0B2A4A;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="55" y="1340" width="280" height="265" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Los permisos los pone SharePoint&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Quién puede abrir o editar cada archivo lo define SharePoint. La aplicación solo usa los permisos que la persona ya tiene en su cuenta." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF0F8;strokeColor=#0B2A4A;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="345" y="1340" width="280" height="265" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Los correos salen con su propia cuenta&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;La aplicación le pide al Outlook del computador que envíe el mensaje. No guarda contraseñas ni usa un servidor de correo propio; cada correo queda en los Enviados de la persona." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF0F8;strokeColor=#0B2A4A;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="635" y="1340" width="280" height="265" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Límite conocido&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Los archivos no son una base de datos: si dos personas guardan casi a la vez, OneDrive puede dejar una copia de conflicto. La app lo reduce con respaldos antes de guardar, guardados en lote y avisos de archivo ocupado." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#D97706;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="925" y="1340" width="280" height="265" as="geometry" />
        </mxCell>

        <!-- ⑨ ACTUALIZACIONES -->
        <mxCell id="upd" value="⑨ ACTUALIZACIONES AUTOMÁTICAS" style="swimlane;rounded=1;arcSize=4;startSize=40;fillColor=#0F766E;swimlaneFillColor=#F2FBFA;strokeColor=#0F766E;fontColor=#FFFFFF;fontSize=15;fontStyle=1;html=1;whiteSpace=wrap;shadow=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1290" width="620" height="330" as="geometry" />
        </mxCell>
        <mxCell id="u1" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Se publica&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Quien desarrolla sube un zip y un archivo version.json a la carpeta compartida «Codigo - APP»." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1275" y="1340" width="190" height="265" as="geometry" />
        </mxCell>
        <mxCell id="u2" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;La app avisa&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Al abrir, y luego cada 10 minutos, revisa la versión publicada. Si hay una nueva, muestra un aviso una sola vez." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1477" y="1340" width="190" height="265" as="geometry" />
        </mxCell>
        <mxCell id="u3" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Un clic&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;«Actualizar ahora» copia solo los archivos que cambiaron, conserva la configuración de cada persona y reabre la app." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#0F766E;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1679" y="1340" width="190" height="265" as="geometry" />
        </mxCell>

        <!-- ⑩ CORREOS -->
        <mxCell id="mail" value="⑩ ¿CÓMO SALE UN CORREO A UN CLIENTE?" style="swimlane;rounded=1;arcSize=4;startSize=40;fillColor=#1C6BBA;swimlaneFillColor=#EEF4FB;strokeColor=#1C6BBA;fontColor=#FFFFFF;fontSize=15;fontStyle=1;html=1;whiteSpace=wrap;shadow=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="1650" width="1840" height="270" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;1 · La persona elige&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Selecciona camiones o clientes y una plantilla (por ejemplo aviso de vencimiento o reactivación)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1C6BBA;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="60" y="1700" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;2 · La app prepara&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Arma el asunto y el mensaje, y busca el correo de cada destinatario en la base de contactos." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1C6BBA;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="520" y="1700" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;3 · Outlook envía&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;El Outlook del computador envía cada correo con la cuenta predeterminada de la persona." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1C6BBA;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="980" y="1700" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;4 · Queda registrado&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cada envío se anota en el historial de correos. Si el correo sale pero el registro falla, la app lo avisa." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#1C6BBA;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1700" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="e_mail1" style="endArrow=block;endFill=1;html=1;strokeColor=#1C6BBA;strokeWidth=3;" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mail2" style="endArrow=block;endFill=1;html=1;strokeColor=#1C6BBA;strokeWidth=3;" edge="1" parent="1" source="c2" target="c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mail3" style="endArrow=block;endFill=1;html=1;strokeColor=#1C6BBA;strokeWidth=3;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LEYENDA -->
        <mxCell id="leyenda" value="&lt;b&gt;Cómo leer las flechas:&lt;/b&gt;   &lt;font color=&quot;#1C6BBA&quot;&gt;━━ azul&lt;/font&gt; la persona usa las pantallas   ·   &lt;font color=&quot;#2E9E5B&quot;&gt;━━ verde&lt;/font&gt; la app lee y guarda en las planillas   ·   &lt;font color=&quot;#D97706&quot;&gt;┅┅ naranja&lt;/font&gt; aviso cuando alguien cambia un archivo por fuera   ·   &lt;font color=&quot;#0F766E&quot;&gt;┅┅ verde azulado&lt;/font&gt; conexión con servicios externos" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#475569;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="1950" width="1840" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
