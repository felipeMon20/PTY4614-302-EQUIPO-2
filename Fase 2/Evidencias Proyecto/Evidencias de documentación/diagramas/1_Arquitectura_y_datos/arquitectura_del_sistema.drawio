        <mxCell id="t5" value="&lt;b&gt;Archivos CSV y Excel&lt;/b&gt; · donde viven los datos" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;align=left;spacingLeft=12;fontSize=12;fontColor=#1E293B;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1275" y="1014" width="290" height="50" as="geometry" />
