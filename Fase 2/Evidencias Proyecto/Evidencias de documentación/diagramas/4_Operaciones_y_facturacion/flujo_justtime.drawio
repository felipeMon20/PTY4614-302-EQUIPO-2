                <mxCell id="p1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="Ingresos y Conciliación › JustTime: empresas con unidades" vertex="1">
                    <mxGeometry height="90" width="230" x="170" y="500" as="geometry"/>
                </mxCell>
                <mxCell id="s1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="Arma el universo: unidades (contrato actual) cuyo tipo de facturación va a JustTime, o con algún estado distinto de «-». Deja fuera los contratos finalizados sin estado" vertex="1">
                    <mxGeometry height="120" width="300" x="440" y="485" as="geometry"/>
                </mxCell>
                <mxCell id="s2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="Detecta inconsistencias: formato antiguo; tipo que va a JustTime sin estado; tipo que no va a JustTime en Si o Pendiente; contrato finalizado que falta eliminar" vertex="1">
                    <mxGeometry height="130" width="330" x="780" y="480" as="geometry"/>
                </mxCell>
                <mxCell id="a1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="Filtra por estado, por tarjeta (Total, Interno, Cliente, Inconsistencias) o busca; abre una empresa" vertex="1">
                    <mxGeometry height="100" width="240" x="1150" y="495" as="geometry"/>
                </mxCell>
                <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" value="¿Qué quiere hacer?" vertex="1">
                    <mxGeometry height="120" width="220" x="1430" y="485" as="geometry"/>
                </mxCell>
                <mxCell id="b1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="Selecciona unidades y presiona «Corregir según matriz», «Aplicar sugerencia» o «Limpiar datos»" vertex="1">
                    <mxGeometry height="110" width="300" x="170" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="b2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="«Arreglar fechas»: muestra la fecha actual y la nueva de cada unidad que sigue en JustTime" vertex="1">
                    <mxGeometry height="110" width="300" x="520" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="b3" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="«Cambiar estado» (dentro de una empresa): pone un mismo estado a todas las unidades mostradas" vertex="1">
                    <mxGeometry height="110" width="300" x="870" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="b4" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="Doble clic o «Editar unidad»: abre el formulario en la pestaña «JustTime &amp;amp; CM»" vertex="1">
                    <mxGeometry height="110" width="300" x="1220" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="s3" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="Pide confirmar y guarda en el Registro Maestro, con copia de seguridad y registro en el historial" vertex="1">
                    <mxGeometry height="60" width="1350" x="170" y="860" as="geometry"/>
                </mxCell>
                <mxCell id="notas" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#9E9E9E;fontSize=12;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• Solo Cliente e Interno van a JustTime (confirmado por Javiera el 05-10-2026). Facturación manual y Provisión + no.&lt;br&gt;• JustTime es un sistema externo: la app no se conecta a él. Que una unidad esté en «Si» lo confirma Javiera a mano.&lt;br&gt;• «Corregir según matriz»: sin estado y con tipo que va a JustTime pasa a Pendiente; Si o Revisar pago en un tipo que no va pasa a Eliminar; Pendiente en un tipo que no va pasa a «-»; con formato antiguo toma el estado sugerido.&lt;br&gt;• «Limpiar datos» deja estado, inicio y término en «-» solo en unidades que no van a JustTime y ya salieron (Eliminar) o conservan fechas sueltas.&lt;br&gt;• Al renovar un contrato, el anterior queda Renovado y, si estaba en Si o Pendiente, pasa a Eliminar.&lt;br&gt;• En el formulario, «-» solo se ofrece si el contrato está en Baja, Baja solicitada o Vencido, y al elegirlo se limpian las fechas.&lt;br&gt;• Las unidades dadas de baja o desconectadas no se marcan como inconsistentes, salvo un contrato finalizado que sigue en Si o Pendiente." vertex="1">
                    <mxGeometry height="210" width="1750" x="20" y="990" as="geometry"/>
                </mxCell>
                <mxCell id="f1" edge="1" parent="1" source="i1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" target="s_nace" value="">
