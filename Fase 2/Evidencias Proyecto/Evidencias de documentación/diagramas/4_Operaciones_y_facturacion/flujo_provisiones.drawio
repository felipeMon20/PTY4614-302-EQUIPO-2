                <mxCell id="s4" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="Hace una copia de seguridad (si falla, cancela). Agrega las filas al final de Prov con Plan vacío y 0 meses, y copia las fórmulas de Monto, Valor plan y VAR" vertex="1">
                    <mxGeometry height="120" width="290" x="1070" y="220" as="geometry"/>
