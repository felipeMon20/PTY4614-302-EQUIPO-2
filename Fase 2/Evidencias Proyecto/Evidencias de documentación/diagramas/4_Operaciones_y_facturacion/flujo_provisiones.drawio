                <mxCell id="p2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="Revisión: tabla con los registros nuevos" vertex="1">
                    <mxGeometry height="80" width="220" x="1660" y="240" as="geometry"/>
