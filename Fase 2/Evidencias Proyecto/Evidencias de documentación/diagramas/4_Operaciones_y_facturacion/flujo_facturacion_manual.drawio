<mxfile host="app.diagrams.net"><diagram id="facturacion-manual" name="Facturación manual"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="titulo" value="&lt;b style=&quot;font-size:20px&quot;&gt;Facturación manual: de la lista del mes a la factura&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot;&gt;Qué empresas se facturan, cómo se define el precio y qué se guarda en cada archivo&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="-130" width="900" height="50" as="geometry" /></mxCell><mxCell id="ley0" value="Pantalla" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley1" value="Acción del usuario" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1125" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley2" value="Sistema" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1290" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley3" value="Fuera de la app" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;dashed=1;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1455" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley_dec" value="Decisión" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="-130" width="110" height="46" as="geometry" /></mxCell><mxCell id="ley_ini" value="INICIO" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#60a917;strokeColor=#2D7600;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1750" y="-134" width="54" height="54" as="geometry" /></mxCell><mxCell id="ley_fin" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1815" y="-134" width="54" height="54" as="geometry" /></mxCell><mxCell id="carril_lis" value="Lista del mes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=16;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="40" height="330" as="geometry" /></mxCell><mxCell id="fondo_lis" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FAF7FC;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="40" width="2010" height="330" as="geometry" /></mxCell><mxCell id="carril_edi" value="Editor de la flota" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="40" height="340" as="geometry" /></mxCell><mxCell id="fondo_edi" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F9FE;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="400" width="2010" height="340" as="geometry" /></mxCell><mxCell id="i1" value="INICIO" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#60a917;strokeColor=#2D7600;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="98" width="54" height="54" as="geometry" /></mxCell><mxCell id="p1" value="Ingresos y Conciliación › Facturación Manual" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="170" y="90" width="220" height="70" as="geometry" /></mxCell><mxCell id="s1" value="Arma la lista del período: cada fila de facturacionManual.xlsx, con las unidades del Registro Maestro que tienen Facturación manual, por RUT" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="430" y="65" width="270" height="120" as="geometry" /></mxCell><mxCell id="s2" value="Suma las empresas con unidades en el Registro Maestro que aún no tienen fila del mes («Sin registro»), en el mes vencido y en el actual" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="65" width="280" height="120" as="geometry" /></mxCell><mxCell id="a1" value="Filtra por período, tipo (OC o Factura manual) y etapa. Las tarjetas muestran empresas, unidades, pendientes y pago" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="70" width="250" height="110" as="geometry" /></mxCell><mxCell id="d1" value="¿Abre el editor de una empresa?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1350" y="75" width="210" height="100" as="geometry" /></mxCell><mxCell id="a_open" value="Doble clic en la empresa o «Abrir editor»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1610" y="90" width="230" height="70" as="geometry" /></mxCell><mxCell id="a2" value="Selecciona una o varias empresas y presiona «Marcar como Facturado» o «Marcar como Pendiente»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1330" y="225" width="250" height="90" as="geometry" /></mxCell><mxCell id="s3" value="Escribe la etapa en facturacionManual.xlsx con copia de seguridad. A las empresas «Sin registro» les crea la fila del mes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="980" y="215" width="300" height="110" as="geometry" /></mxCell><mxCell id="s4" value="Recarga la lista" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="760" y="235" width="170" height="70" as="geometry" /></mxCell><mxCell id="fin1" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="670" y="243" width="54" height="54" as="geometry" /></mxCell><mxCell id="b1" value="Editor de la empresa: resumen de precios, detalle de unidades y panel lateral" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1600" y="455" width="250" height="90" as="geometry" /></mxCell><mxCell id="b2" value="Trae las unidades del Registro Maestro por RUT y propone el nivel de servicio más frecuente (Básico, Medio o Full, con CIV y SZ)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1300" y="440" width="250" height="120" as="geometry" /></mxCell><mxCell id="b3" value="Elige el tipo de gestión (OC o Factura manual), ajusta el nivel y escribe el precio UF por unidad" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="450" width="250" height="100" as="geometry" /></mxCell><mxCell id="b4" value="Calcula el total: precio × unidades, en UF y en CLP con la UF del día. Si ya está Facturado usa la UF con que se facturó" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="440" width="260" height="120" as="geometry" /></mxCell><mxCell id="b5" value="Presiona «Guardar facturación» (se habilita con tipo, precio y UF)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="455" width="220" height="90" as="geometry" /></mxCell><mxCell id="b6" value="Pide confirmar: tipo, precio × unidades, total y plan" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="170" y="460" width="250" height="80" as="geometry" /></mxCell><mxCell id="c1" value="Escribe en facturacionManual.xlsx el precio, el pago en CLP y el tipo (si no había fila del mes, la crea Pendiente). Hace copia de seguridad" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="170" y="595" width="250" height="130" as="geometry" /></mxCell><mxCell id="c2" value="Escribe el plan de la flota en Tipo de servicio de las unidades que tengan otro valor en el Registro Maestro" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="470" y="600" width="280" height="120" as="geometry" /></mxCell><mxCell id="c3" value="Vuelve a la lista" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="800" y="625" width="200" height="70" as="geometry" /></mxCell><mxCell id="fin2" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1060" y="633" width="54" height="54" as="geometry" /></mxCell><mxCell id="a_exp" value="Opcional: «Exportar a PDF» o «Exportar a Excel» con el detalle de unidades y los totales (pide el precio)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1330" y="595" width="300" height="110" as="geometry" /></mxCell><mxCell id="notas" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• La lista sale de dos fuentes: facturacionManual.xlsx aporta tipo, precio, pago y etapa de cada mes; el Registro Maestro define quién se factura y cuántas unidades tiene (por RUT).&lt;br&gt;• Si el Excel y el Registro Maestro difieren en unidades, el editor lo avisa. Una empresa ya Facturada conserva las unidades del Excel, porque su pago se calculó con ellas. Una fila sin RUT no trae unidades.&lt;br&gt;• «Marcar como Facturado» o «Pendiente» actúa sobre todas las empresas seleccionadas y guarda al instante.&lt;br&gt;• Nivel de servicio: CIV no se ofrece en Básico y SZ es Safety Zone. El plan se escribe como, por ejemplo, MEDIO + CIV + SZ.&lt;br&gt;• «Actualizar UF» busca la UF de hoy en internet y, si difiere y el usuario confirma, la guarda en Variables de provisionFelipe.xlsx con copia de seguridad.&lt;br&gt;• Doble clic en una unidad del editor abre su formulario (JustTime &amp;amp; CM) para editarla y guardarla.&lt;br&gt;• La pantalla abre en el mes en curso. Los registros Facturados muestran la «UF de facturación»; los Pendientes, la «UF del día»." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#9E9E9E;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="1750" height="210" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i1" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s2" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a1" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="a_open"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s4" target="fin1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a_open" target="b1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b6" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="fin2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" value="opcional" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="b3" target="a_exp"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>