        <mxCell id="e6" value="Guarda Inicio y Término&lt;br&gt;al aprobar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7B1FA2;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="generar" target="registro">
          <mxGeometry relative="1" as="geometry" />
