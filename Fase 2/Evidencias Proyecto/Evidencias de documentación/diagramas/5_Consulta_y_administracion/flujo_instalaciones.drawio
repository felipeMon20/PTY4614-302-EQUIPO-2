        <mxCell id="e9" value="Crea la hoja&lt;br&gt;del mes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="generar" target="instalaciones">
          <mxGeometry relative="1" as="geometry" />
