        <mxCell id="e8" value="Administrador de&lt;br&gt;flota por CDB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.764;entryY=1;" edge="1" parent="1" source="contactos" target="generar">
          <mxGeometry relative="1" as="geometry" />
