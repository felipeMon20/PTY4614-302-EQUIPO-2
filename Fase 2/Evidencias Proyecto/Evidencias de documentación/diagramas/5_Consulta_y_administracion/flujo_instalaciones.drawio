        <mxCell id="e5" value="RUT, CDB, chasis&lt;br&gt;y razón social" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="registro" target="generar">
          <mxGeometry relative="1" as="geometry" />
