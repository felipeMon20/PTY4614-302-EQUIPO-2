        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9E9E9E;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="javiera" target="registro">
          <mxGeometry relative="1" as="geometry" />
