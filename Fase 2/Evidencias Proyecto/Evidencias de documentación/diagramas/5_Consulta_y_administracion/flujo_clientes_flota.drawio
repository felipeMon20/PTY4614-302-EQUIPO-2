                <mxCell id="cz2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="Presiona «Unificar en una sola razón social» y confirma" vertex="1">
                    <mxGeometry height="100" width="290" x="1380" y="450" as="geometry"/>
