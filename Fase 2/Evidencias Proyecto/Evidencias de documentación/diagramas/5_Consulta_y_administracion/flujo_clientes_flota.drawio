                <mxCell id="cz3" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="Renombra las otras razones a la que tiene más unidades; guarda con copia de seguridad y registro en el historial" vertex="1">
