                    <mxGeometry height="90" width="230" x="170" y="115" as="geometry"/>
                </mxCell>
                <mxCell id="c2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="Agrupa por RUT (sin RUT, por razón social). La razón principal es la más frecuente. Cuenta unidades y flotas; «SIN FLOTA» y «NO EXISTE EN VC» no cuentan como flota" vertex="1">
                    <mxGeometry height="140" width="310" x="440" y="90" as="geometry"/>
