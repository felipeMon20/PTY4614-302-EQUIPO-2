                </mxCell>
                <mxCell id="cc2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="Presiona «Agregar contacto»: el formulario trae el CDB Flota del cliente ya escrito" vertex="1">
                    <mxGeometry height="110" width="290" x="1060" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="cc3" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="Guarda el contacto en contactos.xlsx y la pestaña se recarga sola" vertex="1">
                    <mxGeometry height="110" width="290" x="740" y="450" as="geometry"/>
