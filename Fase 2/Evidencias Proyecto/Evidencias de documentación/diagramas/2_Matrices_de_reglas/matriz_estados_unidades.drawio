&quot;font-size:10px&quot; color=&quot;#78909C&quot;&gt;Sin contrato nuevo aquí&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot; color=&quot;#C62828&quot;&gt;⚠ Error de dato&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fad7ac;strokeColor=#b46504;strokeWidth=2;shadow=1;dashed=1;strokeColor=#C62828;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="950" y="630" width="170" height="88" as="geometry" /></mxCell><mxCell id="c51" value="&lt;b style=&quot;font-size:13px&quot;&gt;Sin Flota&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#455A64&quot;&gt;Operaciones&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#78909C&quot;&gt;Sin contrato nuevo aquí&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:10px&quot; color=&quot;#C62828&quot;&gt;⚠ Error de dato&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;dashed=1;strokeColor=#C62828;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1130" y="630" width="170" height="88" as="geometry" /></mxCell><mxCell id="c52" value="&lt;b&gt;Cómo leerla&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="748" width="300" height="26" as="geometry" /></mxCell><mxCell id="c53" value="&lt;b&gt;Renovar contratos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Comercial&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="782" width="170" height="44" as="geometry" /></mxCell><mxCell id="c54" value="&lt;b&gt;Nuevas oportunidades&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Comercial&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#b0e3e6;strokeColor=#0e8088;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="782" width="170" height="44" as="geometry" /></mxCell><mxCell id="c55" value="&lt;b&gt;Recuperar clientes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Comercial&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="782" width="170" height="44" as="geometry" /></mxCell><mxCell id="c56" value="&lt;b&gt;Activaciones&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Operaciones&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fad7ac;strokeColor=#b46504;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="782" width="170" height="44" as="geometry" /></mxCell><mxCell id="c57" value="&lt;b&gt;Sin Flota&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Operaciones&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="782" width="170" height="44" as="geometry" /></mxCell><mxCell id="c58" value="&lt;b&gt;Bajas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Operaciones&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e3e3e3;strokeColor=#757575;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="782" width="170" height="44" as="geometry" /></mxCell><mxCell id="c59" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• El destino sale de ESTADO COMERCIAL y ESTADO DE ACTIVACIÓN ACTUAL (ETAPA GESTIÓN se calcula con la misma matriz). No cambia con la fecha de término: se probó con fecha vencida, por vencer, futura y MENSUAL.&lt;br&gt;• &lt;b&gt;Renueva con contrato nuevo:&lt;/b&gt; si el contrato actual está Vigente o Vencido, el botón «Nuevo contrato» de Renovar contratos crea uno nuevo y el actual pasa a Renovado. No pasa por Baja ni hay que desconectar la unidad. El botón solo está en esa pestaña.&lt;br&gt;• &lt;b&gt;Permite contrato nuevo:&lt;/b&gt; el contrato actual ya está en Baja o Baja solicitada y la unidad no está Activando ni Conectada; también Revisar con No aplica (unidades «SIN VC»).&lt;br&gt;• &lt;b&gt;⚠ Error de dato:&lt;/b&gt; combinación que el negocio considera que no debería existir. Viene de los diagramas originales; el código no la valida, la unidad igual aparece en la pestaña indicada.&lt;br&gt;• &lt;b&gt;† No entregado:&lt;/b&gt; el filtro de Operaciones todavía lo manda a Activaciones, pero desde el 15-10-2026 la sincronización lo convierte en Sin flota, así que en la práctica llega como Sin flota.&lt;br&gt;• Vigente + Conectado además aparece en Operaciones › Datos de flota. «Oportunidades CM» es aparte y no depende de esta matriz." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#9E9E9E;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="844" width="1130" height="230" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>