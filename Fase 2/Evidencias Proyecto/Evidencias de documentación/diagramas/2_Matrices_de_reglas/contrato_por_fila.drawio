                </mxCell>
                <mxCell id="a1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="«Crear contrato»: la unidad tiene el contrato en Baja y ya no está Activando ni Conectada" vertex="1">
