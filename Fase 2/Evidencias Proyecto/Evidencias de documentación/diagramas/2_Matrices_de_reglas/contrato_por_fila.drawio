                <mxCell id="a3" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" value="«Extender duración»: se suman meses a un contrato Vigente o Vencido" vertex="1">
