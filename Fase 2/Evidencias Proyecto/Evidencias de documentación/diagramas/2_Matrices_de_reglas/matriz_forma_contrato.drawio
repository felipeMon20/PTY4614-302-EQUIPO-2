mxCell><mxCell id="c72" value="✕" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBEDEC;strokeColor=#E6B8B5;fontColor=#C98A87;fontSize=14;" vertex="1" parent="1"><mxGeometry x="628" y="526" width="140" height="46" as="geometry" /></mxCell><mxCell id="c73" value="✕" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBEDEC;strokeColor=#E6B8B5;fontColor=#C98A87;fontSize=14;" vertex="1" parent="1"><mxGeometry x="774" y="526" width="140" height="46" as="geometry" /></mxCell><mxCell id="c74" value="✕" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBEDEC;strokeColor=#E6B8B5;fontColor=#C98A87;fontSize=14;" vertex="1" parent="1"><mxGeometry x="920" y="526" width="140" height="46" as="geometry" /></mxCell><mxCell id="c75" value="&lt;b&gt;✔ Válido&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="578" width="140" height="46" as="geometry" /></mxCell><mxCell id="c76" value="✕" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBEDEC;strokeColor=#E6B8B5;fontColor=#C98A87;fontSize=14;" vertex="1" parent="1"><mxGeometry x="336" y="578" width="140" height="46" as="geometry" /></mxCell><mxCell id="c77" value="✕" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBEDEC;strokeColor=#E6B8B5;fontColor=#C98A87;fontSize=14;" vertex="1" parent="1"><mxGeometry x="482" y="578" width="140" height="46" as="geometry" /></mxCell><mxCell id="c78" value="✕" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBEDEC;strokeColor=#E6B8B5;fontColor=#C98A87;fontSize=14;" vertex="1" parent="1"><mxGeometry x="628" y="578" width="140" height="46" as="geometry" /></mxCell><mxCell id="c79" value="✕" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBEDEC;strokeColor=#E6B8B5;fontColor=#C98A87;fontSize=14;" vertex="1" parent="1"><mxGeometry x="774" y="578" width="140" height="46" as="geometry" /></mxCell><mxCell id="c80" value="✕" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBEDEC;strokeColor=#E6B8B5;fontColor=#C98A87;fontSize=14;" vertex="1" parent="1"><mxGeometry x="920" y="578" width="140" height="46" as="geometry" /></mxCell><mxCell id="c81" value="✕" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBEDEC;strokeColor=#E6B8B5;fontColor=#C98A87;fontSize=14;" vertex="1" parent="1"><mxGeometry x="190" y="630" width="140" height="46" as="geometry" /></mxCell><mxCell id="c82" value="&lt;b&gt;✔ Válido&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;va a JustTime&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="336" y="630" width="140" height="46" as="geometry" /></mxCell><mxCell id="c83" value="✕" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBEDEC;strokeColor=#E6B8B5;fontColor=#C98A87;fontSize=14;" vertex="1" parent="1"><mxGeometry x="482" y="630" width="140" height="46" as="geometry" /></mxCell><mxCell id="c84" value="&lt;b&gt;✔ Válido&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="628" y="630" width="140" height="46" as="geometry" /></mxCell><mxCell id="c85" value="✕" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBEDEC;strokeColor=#E6B8B5;fontColor=#C98A87;fontSize=14;" vertex="1" parent="1"><mxGeometry x="774" y="630" width="140" height="46" as="geometry" /></mxCell><mxCell id="c86" value="✕" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBEDEC;strokeColor=#E6B8B5;fontColor=#C98A87;fontSize=14;" vertex="1" parent="1"><mxGeometry x="920" y="630" width="140" height="46" as="geometry" /></mxCell><mxCell id="c87" value="✔ Válido: pueden ir juntos" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="702" width="260" height="36" as="geometry" /></mxCell><mxCell id="c88" value="✔ Válido y va a JustTime" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="702" width="260" height="36" as="geometry" /></mxCell><mxCell id="c89" value="✕ No pueden ir juntos" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FBEDEC;strokeColor=#E6B8B5;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="702" width="260" height="36" as="geometry" /></mxCell><mxCell id="c90" value="&lt;b&gt;Cómo lo usa la app&lt;/b&gt;&lt;br&gt;• &lt;b&gt;La forma de contrato manda.&lt;/b&gt; Al elegirla en el formulario de la unidad, la app deja solo los tipos de facturación válidos. Si hay uno solo, lo completa sola; con Conversión o Venta hay que elegir entre Cliente y Facturación manual.&lt;br&gt;• &lt;b&gt;Revisar inconsistencias&lt;/b&gt; marca los datos históricos que no cumplen la matriz. Un tipo de facturación vacío o «-» no se marca: significa «sin asignar».&lt;br&gt;• &lt;b&gt;JustTime:&lt;/b&gt; solo van Cliente e Interno. Facturación manual y Provisión + no (confirmado por Javiera el 05-10-2026)." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#9E9E9E;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="758" width="1090" height="150" as="geometry" /></mxCell><mxCell id="c91" value="Cómo cambia la forma de contrato" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1180" y="20" width="520" height="36" as="geometry" /></mxCell><mxCell id="c92" value="Provisión" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=2;shadow=1;fontSize=14;fontStyle=1;fillColor=#ECEFF1;strokeColor=#90A4AE;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="140" height="54" as="geometry" /></mxCell><mxCell id="c93" value="Conversión" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=2;shadow=1;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1430" y="100" width="140" height="54" as="geometry" /></mxCell><mxCell id="c94" value="CMB / CMG / CMS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=2;shadow=1;fontSize=14;fontStyle=1;fillColor=#ECEFF1;strokeColor=#90A4AE;" vertex="1" parent="1"><mxGeometry x="1430" y="200" width="140" height="54" as="geometry" /></mxCell><mxCell id="c95" value="Venta" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=2;shadow=1;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1600" y="200" width="100" height="54" as="geometry" /></mxCell><mxCell id="c96" value="Provisión +" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=2;shadow=1;fontSize=14;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1180" y="330" width="140" height="54" as="geometry" /></mxCell><mxCell id="c97" value="Sin contrato" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=2;shadow=1;fontSize=14;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1430" y="330" width="140" height="54" as="geometry" /></mxCell><mxCell id="e98" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c92" target="c93"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e99" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c92" target="c94"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e100" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c94" target="c95"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e101" value="Se acaba la bolsa: baja" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c96" target="c97"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c102" value="&lt;b&gt;Conversión y Venta se parecen.&lt;/b&gt; La diferencia es el origen: la Conversión viene de una Provisión; la Venta nace directa.&lt;br&gt;&lt;br&gt;&lt;b&gt;Provisión +&lt;/b&gt; es una bolsa que el cliente va dando para pagar, sin fecha de término predeterminada. Cuando se acaba, se da de baja. La app no la trata como mensual: usa la fecha de término que traiga el dato.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot;&gt;Este ciclo lo describe el negocio; el código no lo valida ni lo fuerza.&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#9E9E9E;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1180" y="420" width="520" height="230" as="geometry" /></mxCell><mxCell id="c103" value="Contrato de mantenimiento (CM)" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1180" y="700" width="520" height="36" as="geometry" /></mxCell><mxCell id="c104" value="Forma de contrato&lt;br&gt;CMB / CMG / CMS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=2;shadow=1;fontSize=14;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1180" y="770" width="170" height="60" as="geometry" /></mxCell><mxCell id="c105" value="Tipo de facturación&lt;br&gt;es CM" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;strokeWidth=2;shadow=1;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1440" y="770" width="170" height="60" as="geometry" /></mxCell><mxCell id="c106" value="&lt;b&gt;Tipo de CM&lt;/b&gt; se completa solo:&lt;br&gt;CMB → Blue&lt;br&gt;CMG → Gold&lt;br&gt;CMS → Silver" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="890" width="170" height="100" as="geometry" /></mxCell><mxCell id="c107" value="&lt;b&gt;Se habilitan&lt;/b&gt; en la pestaña «JustTime &amp;amp; CM»:&lt;br&gt;N° contrato 3PC, Tipo de CM, Estado del CM, Fecha inicio CM, Fecha término CM y Pago CM" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="890" width="260" height="100" as="geometry" /></mxCell><mxCell id="e108" value="obliga a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c104" target="c105"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e109" value="completa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c104" target="c106"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e110" value="habilita" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c105" target="c107"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c111" value="• Si eliges el Tipo de CM a mano, la app ya no lo vuelve a pisar.&lt;br&gt;• Si en el formulario cambias el tipo de facturación a uno que no es CM, esos campos se limpian a «-».&lt;br&gt;• Con otro tipo de facturación, los campos de CM quedan bloqueados." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#9E9E9E;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1180" y="1010" width="520" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>