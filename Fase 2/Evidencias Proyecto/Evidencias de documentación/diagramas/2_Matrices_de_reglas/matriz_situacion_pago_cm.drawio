<mxfile host="app.diagrams.net"><diagram id="matriz-pago-cm" name="Situación de pago CM"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="titulo" value="&lt;b style=&quot;font-size:20px&quot;&gt;Matriz de situación de pago de los contratos CM&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot;&gt;Qué cola recibe cada contrato y qué botón la resuelve, según ESTADO COMERCIAL, ESTADO DEL CM y si pagó este mes. Cifras al 27-10-2026 (1.445 contratos)&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="-70" width="1100" height="50" as="geometry" /></mxCell><mxCell id="m1" value="ESTADO DEL CM Y PAGO DEL MES" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#37474F;strokeColor=#263238;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="240" y="30" width="1010" height="38" as="geometry" /></mxCell><mxCell id="m2" value="RUNNING y pagó este mes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#90A4AE;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="78" width="330" height="44" as="geometry" /></mxCell><mxCell id="m3" value="RUNNING sin pago este mes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#90A4AE;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="78" width="330" height="44" as="geometry" /></mxCell><mxCell id="m4" value="EXPIRED" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#90A4AE;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="78" width="330" height="44" as="geometry" /></mxCell><mxCell id="m5" value="ESTADO COMERCIAL" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#37474F;strokeColor=#263238;fontSize=14;fontStyle=1;fontColor=#FFFFFF;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="132" width="38" height="502" as="geometry" /></mxCell><mxCell id="m6" value="VIGENTE" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#90A4AE;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="132" width="162" height="118" as="geometry" /></mxCell><mxCell id="m7" value="ACTIVACIÓN PENDIENTE" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#90A4AE;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="260" width="162" height="118" as="geometry" /></mxCell><mxCell id="m8" value="VENCIDO" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#90A4AE;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="388" width="162" height="118" as="geometry" /></mxCell><mxCell id="m9" value="REVISAR" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#90A4AE;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="68" y="516" width="162" height="118" as="geometry" /></mxCell><mxCell id="m10" value="AL DÍA&lt;br&gt;&lt;b&gt;1.188&lt;/b&gt; contratos&lt;br&gt;No requiere acción" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="132" width="330" height="118" as="geometry" /></mxCell><mxCell id="m11" value="SIN PAGO&lt;br&gt;&lt;b&gt;2&lt;/b&gt; contratos&lt;br&gt;Revisar el pago" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="132" width="330" height="118" as="geometry" /></mxCell><mxCell id="m12" value="No se da&lt;br&gt;&lt;b&gt;0&lt;/b&gt; contratos" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#BDBDBD;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="132" width="330" height="118" as="geometry" /></mxCell><mxCell id="m13" value="AL DÍA&lt;br&gt;&lt;b&gt;45&lt;/b&gt; contratos&lt;br&gt;No requiere acción" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="260" width="330" height="118" as="geometry" /></mxCell><mxCell id="m14" value="No se da&lt;br&gt;&lt;b&gt;0&lt;/b&gt; contratos" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#BDBDBD;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="260" width="330" height="118" as="geometry" /></mxCell><mxCell id="m15" value="SIN PAGO&lt;br&gt;&lt;b&gt;2&lt;/b&gt; contratos&lt;br&gt;Gestionar en Oportunidades CM (Comercial)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="260" width="330" height="118" as="geometry" /></mxCell><mxCell id="m16" value="POR ACTUALIZAR&lt;br&gt;&lt;b&gt;106&lt;/b&gt; contratos&lt;br&gt;Botón «Marcar vigente» (si está conectada)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="388" width="330" height="118" as="geometry" /></mxCell><mxCell id="m17" value="No se da&lt;br&gt;&lt;b&gt;0&lt;/b&gt; contratos" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#BDBDBD;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="388" width="330" height="118" as="geometry" /></mxCell><mxCell id="m18" value="SIN PAGO&lt;br&gt;&lt;b&gt;78&lt;/b&gt; contratos&lt;br&gt;Gestionar en Oportunidades CM (Comercial), o Extender duración" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="388" width="330" height="118" as="geometry" /></mxCell><mxCell id="m19" value="POR ACTUALIZAR&lt;br&gt;&lt;b&gt;24&lt;/b&gt; contratos&lt;br&gt;Botón «Marcar vigente» (si está conectada)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="516" width="330" height="118" as="geometry" /></mxCell><mxCell id="m20" value="SIN PAGO&lt;br&gt;&lt;b&gt;0&lt;/b&gt; contratos&lt;br&gt;Botón «Marcar vencido»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="516" width="330" height="118" as="geometry" /></mxCell><mxCell id="m21" value="No se da&lt;br&gt;&lt;b&gt;0&lt;/b&gt; contratos" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F5F5;strokeColor=#BDBDBD;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="516" width="330" height="118" as="geometry" /></mxCell><mxCell id="m22" value="&lt;b&gt;Columnas de la fase 1&lt;/b&gt;&lt;br&gt;AL DÍA = 1.233 (verde) · POR ACTUALIZAR = 130 (ámbar) · SIN PAGO = 82 (rojo). Suman los 1.445 contratos." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#9E9E9E;fontSize=12;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="664" width="1090" height="64" as="geometry" /></mxCell><mxCell id="m23" value="&lt;b&gt;Regla de «Marcar vigente» y «Marcar vencido»&lt;/b&gt;&lt;br&gt;• Vencido o Revisar pasan a &lt;b&gt;Vigente&lt;/b&gt; si la unidad está Conectada, el CM está Running y el último pago CM es de este mes.&lt;br&gt;• Revisar sin pago este mes pasa a &lt;b&gt;Vencido&lt;/b&gt;.&lt;br&gt;• Cualquier otro caso no cambia. Después del cambio la etapa de gestión se recalcula sola.&lt;br&gt;• El pago del mes se toma de PAGO CM y FECHA ULTIMO PAGO CM del Registro Maestro (3PC)." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="738" width="1090" height="128" as="geometry" /></mxCell><mxCell id="m24" value="&lt;b&gt;Otras reglas de la pantalla&lt;/b&gt;&lt;br&gt;• «Forma no es CM» (202): tipo de CM Gold, Blue o Silver con otra forma de contrato; botón «Pasar a CM» (CMB, CMG o CMS) y facturación CM.&lt;br&gt;• «Ausentes del 3PC» (0): estaba con CM y no vino en el último Excel; botón «Confirmar baja».&lt;br&gt;• Los Expired (CM en Expired) ya no tienen cola aquí: se gestionan en Comercial → Oportunidades CM. En esta matriz solo se ven como «Sin pago».&lt;br&gt;• Los contratos en Baja no se muestran, así que «Desconectado» no aparece en esta pantalla." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#9E9E9E;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="876" width="1090" height="128" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>