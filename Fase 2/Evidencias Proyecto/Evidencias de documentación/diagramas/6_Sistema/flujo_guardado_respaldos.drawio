<mxfile host="app.diagrams.net"><diagram id="guardado" name="Guardado y respaldos"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1900" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="titulo" value="&lt;b style=&quot;font-size:20px&quot;&gt;Guardado, respaldos y cambios externos&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot;&gt;Cómo se protege cada guardado, cuándo se hacen copias completas y qué pasa si alguien más toca los archivos&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="-130" width="950" height="50" as="geometry" /></mxCell><mxCell id="ley0" value="Pantalla" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley1" value="Acción del usuario" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1165" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley2" value="Sistema" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1330" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley3" value="Fuera de la app" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;dashed=1;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1495" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley_dec" value="Decisión" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1660" y="-130" width="110" height="46" as="geometry" /></mxCell><mxCell id="ley_ini" value="INICIO" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#60a917;strokeColor=#2D7600;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1790" y="-134" width="54" height="54" as="geometry" /></mxCell><mxCell id="ley_fin" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1860" y="-134" width="54" height="54" as="geometry" /></mxCell><mxCell id="carril_g" value="Cada guardado" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=16;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="40" height="680" as="geometry" /></mxCell><mxCell id="fondo_g" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FDF6F5;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="40" width="2010" height="680" as="geometry" /></mxCell><mxCell id="carril_r" value="Respaldos, cambios externos y bloqueos" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=16;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="40" height="760" as="geometry" /></mxCell><mxCell id="fondo_r" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFCF2;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="760" width="2010" height="760" as="geometry" /></mxCell><mxCell id="i1" value="INICIO" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#60a917;strokeColor=#2D7600;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="148" width="54" height="54" as="geometry" /></mxCell><mxCell id="g1" value="Guarda un cambio desde cualquier pantalla (editar, marcar, enviar a operaciones, etc.)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="170" y="110" width="250" height="110" as="geometry" /></mxCell><mxCell id="g2" value="Arma el cambio por VIN e ID de contrato y lo guarda en un hilo aparte; la pantalla muestra «Guardando…»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="460" y="95" width="290" height="140" as="geometry" /></mxCell><mxCell id="g3" value="Hace una copia de seguridad del archivo en data/backups (nombre_backup_fecha) y conserva las últimas 10 de cada archivo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="790" y="90" width="290" height="150" as="geometry" /></mxCell><mxCell id="gd1" value="¿Se pudo hacer la copia?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="100" width="250" height="130" as="geometry" /></mxCell><mxCell id="g4" value="Aplica los cambios en un archivo temporal (data/temp) y lo graba al disco" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1410" y="95" width="290" height="130" as="geometry" /></mxCell><mxCell id="g5" value="Copia el temporal sobre el archivo real y lo borra" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1740" y="100" width="300" height="120" as="geometry" /></mxCell><mxCell id="gx1" value="No toca el archivo: cancela el guardado y avisa para que lo reintentes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1120" y="280" width="250" height="110" as="geometry" /></mxCell><mxCell id="fx1" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1218" y="430" width="54" height="54" as="geometry" /></mxCell><mxCell id="gd2" value="¿El archivo está bloqueado o falló?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1790" y="290" width="250" height="130" as="geometry" /></mxCell><mxCell id="gx2" value="No guarda: borra los temporales y avisa que SharePoint puede estar bloqueando el archivo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1440" y="290" width="300" height="130" as="geometry" /></mxCell><mxCell id="fx2" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1563" y="460" width="54" height="54" as="geometry" /></mxCell><mxCell id="g6" value="Anota cada campo cambiado en LogApp.csv: fecha, módulo, identificador, campo, valor anterior y nuevo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1740" y="540" width="300" height="130" as="geometry" /></mxCell><mxCell id="g7" value="Actualiza la memoria y avisa a todas las pantallas (data_ready) para que se refresquen" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1390" y="545" width="290" height="120" as="geometry" /></mxCell><mxCell id="g8" value="Mensaje «Cambios guardados»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="550" width="250" height="100" as="geometry" /></mxCell><mxCell id="fg" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="573" width="54" height="54" as="geometry" /></mxCell><mxCell id="ia" value="INICIO" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#60a917;strokeColor=#2D7600;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="868" width="54" height="54" as="geometry" /></mxCell><mxCell id="w1" value="Al abrir la aplicación revisa si toca la copia semanal" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="170" y="830" width="260" heig