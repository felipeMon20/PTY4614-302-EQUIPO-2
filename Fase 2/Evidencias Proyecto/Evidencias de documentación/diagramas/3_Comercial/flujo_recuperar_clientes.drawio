reos" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2b3;strokeColor=#B09500;fontStyle=1;fontSize=16;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="930" width="40" height="460" as="geometry" /></mxCell><mxCell id="fondo_cor" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFDF2;strokeColor=#B09500;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="930" width="2010" height="460" as="geometry" /></mxCell><mxCell id="ini" value="INICIO" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#60a917;strokeColor=#2D7600;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="428" width="54" height="54" as="geometry" /></mxCell><mxCell id="p1" value="Comercial › Recuperar clientes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="180" y="420" width="190" height="70" as="geometry" /></mxCell><mxCell id="s0" value="Lista los contratos en Baja o Baja solicitada cuya unidad está Desconectada, No aplica, No entregado o Sin flota" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="410" y="410" width="250" height="90" as="geometry" /></mxCell><mxCell id="a1" value="Selecciona las unidades del cliente" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="190" height="70" as="geometry" /></mxCell><mxCell id="a2" value="Presiona «Enviar correo»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontS