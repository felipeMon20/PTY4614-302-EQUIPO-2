<mxfile host="app.diagrams.net"><diagram id="recuperar-clientes" name="Recuperar clientes"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1700" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="titulo" value="&lt;b style=&quot;font-size:20px&quot;&gt;Recuperar clientes: paso a paso&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot;&gt;Ofrecer de nuevo el servicio a un cliente con contrato en baja y, si acepta, crearle un contrato nuevo&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="-130" width="900" height="50" as="geometry" /></mxCell><mxCell id="ley0" value="Pantalla" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley1" value="Acción del usuario" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1125" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley2" value="Sistema" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1290" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley3" value="Fuera de la app" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;dashed=1;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1455" y="-125" width="150" height="36" 