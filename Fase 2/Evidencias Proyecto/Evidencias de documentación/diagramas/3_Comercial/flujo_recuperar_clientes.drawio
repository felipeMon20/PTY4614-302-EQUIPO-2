eometry" /></mxCell><mxCell id="k1" value="Selecciona la unidad en Recuperar clientes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="430" y="700" width="210" height="70" as="geometry" /></mxCell><mxCell id="k2" value="Presiona «Crear contrato»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="690" y="700" width="160" height="70" as="geometry" /></mxCell><mxCell id="k3" value="Abre «Unidad nueva» en modo Nuevo contrato: hereda unidad y cliente, deja las condiciones en blanco y bloquea el VIN" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="680" width="260" height="110" as="geometry" /></mxCell><mxCell id="k4" value="Completa el contrato (forma de contrato distinta de Sin contrato, duración) y presiona Guardar" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1210" y="695" width="240" height="80" as="geometry" /></mxCell><mxCell id="k5" value="Agrega un contrato nuevo con Activación pendiente y Activando. El contrato anterior queda como historial" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1500" y="680" width="280" height="110" as="geometry" /></mxCell><mxCell id="g1" value="Gestor de Correos: tabla de clientes con las unidades marcadas" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1780" y="980" width="220" height="70" as="geometry" /></mxCell><mxCell id="g2" value="Elige la plantilla y revisa asunto, CC y destinatarios" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1520" y="980" width="210" height="70" as="geometry" /></mxCell><mxCell id="g3" value="¿El cliente tiene correo registrado?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1270" y="965" width="190" height="100" as="geometry" /></mxCell><mxCell id="g4" value="Presiona «Abrir N borradores en Outlook»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="980" width="200" height="70" as="geometry" /></mxCell><mxCell id="g5" value="Crea un borrador por destinatario con la plantilla y lo muestra" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="980" width="200" height="70" as="geometry" /></mxCell><mxCell id="g6" value="Outlook: envías o cierras cada borrador" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;dashed=1;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="530" y="980" width="200" height="70" as="geometry" /></mxCell><mxCell id="g7" value="Anota el resultado en el Registro de envíos (ENVIADO o CERRADO SIN ENVIAR)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="530" y="1130" width="200" height="80" as="geometry" /></mxCell><mxCell id="h1" value="Avisa «sin correo»: el borrador se abriría sin destinatario" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1270" y="1120" width="190" height="70" as="geometry" /></mxCell><mxCell id="h2" value="Clic derecho › Agregar correo: formulario de Contactos con CDB y razón social ya cargados" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1250" y="1220" width="230" height="80" as="geometry" /></mxCell><mxCell id="h3" value="Guarda en contactos.xlsx y actualiza Correos.csv" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="1225" width="220" height="70" as="geometry" /></mxCell><mxCell id="o1" value="Operaciones › Activaciones" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1800" y="130" width="220" height="70" as="geometry" /></mxCell><mxCell id="o2" value="ISOS: busca el VIN y conecta la unidad en Volvo Connect" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;dashed=1;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1520" y="130" width="230" height="70" as="geometry" /></mxCell><mxCell id="o3" value="Marcar como CONECTADO y elige la fecha de activación" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1250" y="130" width="230" height="70" as="geometry" /></mxCell><mxCell id="o4" value="Activación = Conectado y Estado comercial = Vigente" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="990" y="130" width="220" height="70" as="geometry" /></mxCell><mxCell id="o5" value="Comercial › Renovar contratos" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="730" y="130" width="220" height="70" as="geometry" /></mxCell><mxCell id="fin3" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="138" width="54" height="54" as="geometry" /></mxCell><mxCell id="notas" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• Las unidades con baja que siguen Activando o Conectadas no aparecen aquí: las ve Operaciones en Bajas, para desconectarlas.&lt;br&gt;• Un contrato en baja está cerrado: no se edita. Por eso se crea un contrato nuevo y el anterior queda como historial (ya no se usa «Editar unidad» en esta pestaña).&lt;br&gt;• Ninguna plantilla viene preseleccionada aquí. Entre las 12 plantillas existe «Reactivación»; se elige a mano.&lt;br&gt;• Sin correo no bloquea: el borrador se abre igual, sin destinatario. El correo se puede agregar antes con clic derecho; el botón «Agregar contacto» de la pestaña hace lo mismo.&lt;br&gt;• «Clientes contactados» cuenta los que tienen un correo en Historial_Envios_VC.csv en los últimos 14 días.&lt;br&gt;• Desde Activaciones el camino es el mismo de «Unidad nueva»: si la unidad no existe en Volvo Connect se marca como SIN FLOTA y se conecta después." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#9E9E9E;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="1430" width="1400" height="190" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ini" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1" target="s0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s0" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a2" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelB