<mxfile host="app.diagrams.net"><diagram id="vencido-extender" name="Vencido y Extender"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="titulo" value="&lt;b style=&quot;font-size:20px&quot;&gt;Marcar como Vencido y Extender duración&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot;&gt;Cómo se corrige el estado de un contrato con término pasado y cómo se le suman meses sin crear un contrato nuevo&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="-130" width="950" height="50" as="geometry" /></mxCell><mxCell id="ley0" value="Pantalla" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley1" value="Acción del usuario" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1165" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley2" value="Sistema" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1330" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley3" value="Fuera de la app" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;dashed=1;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1495" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley_dec" value="Decisión" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1660" y="-130" width="110" height="46" as="geometry" /></mxCell><mxCell id="ley_ini" value="INICIO" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#60a917;strokeColor=#2D7600;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1790" y="-134" width="54" height="54" as="geometry" /></mxCell><mxCell id="ley_fin" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1860" y="-134" width="54" height="54" as="geometry" /></mxCell><mxCell id="carril_a" value="Marcar como Vencido" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=16;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="40" height="440" as="geometry" /></mxCell><mxCell id="fondo_a" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FDF6F5;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="40" width="2010" height="440" as="geometry" /></mxCell><mxCell id="carril_b" value="Extender duración" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=16;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="40" height="560" as="geometry" /></mxCell><mxCell id="fondo_b" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F6FBF5;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="520" width="2010" height="560" as="geometry" /></mxCell><mxCell id="ia" value="INICIO" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#60a917;strokeColor=#2D7600;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="148" width="54" height="54" as="geometry" /></mxCell><mxCell id="pa1" value="Comercial › Renovar contratos" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="170" y="120" width="220" height="90" as="geometry" /></mxCell><mxCell id="sa1" value="Detecta las unidades con el término ya pasado que siguen Vigente o en Activación pendiente. No cuenta Baja, Baja solicitada ni Revisar" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="95" width="320" height="140" as="geometry" /></mxCell><mxCell id="da" value="¿Desde dónde lo marca?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="108" width="220" height="114" as="geometry" /></mxCell><mxCell id="aa1" value="Selecciona filas y presiona «Marcar como Vencido» (se habilita si alguna es corregible)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="55" width="270" height="100" as="geometry" /></mxCell><mxCell id="aa2" value="Presiona el botón de la barra (calendario con contador): marca toda la cartera pendiente" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="200" width="270" height="100" as="geometry" /></mxCell><mxCell id="sa2" value="Fija Estado comercial = Vencido y recalcula la Etapa de gestión según la matriz (así sale de Operaciones si estaba ahí)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1420" y="120" width="290" height="120" as="geometry" /></mxCell><mxCell id="sa3" value="Guarda por ID de contrato con copia de seguridad e historial y avisa a las demás pantallas" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1750" y="120" width="250" height="120" as="geometry" /></mxCell><mxCell id="fa" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2020" y="153" width="54" height="54" as="geometry" /></mxCell><mxCell id="ib" value="INICIO" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#60a917;strokeColor=#2D7600;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="648" width="54" height="54" as="geometry" /></mxCell><mxCell id="pb1" value="Comercial › Renovar contratos: tabla de unidades" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="170" y="620" width="220" height="90" as="geometry" /></mxCell><mxCell id="ab1" value="Selecciona una o varias unidades y presiona «Extender duración»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="440" y="610" width="250" height="100" as="geometry" /></mxCell><mxCell id="db" value="¿Hay contratos renovables en la selección?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="595" width="260" height="130" as="geometry" /></mxCell><mxCell id="sb0" value="El botón queda deshabilitado: no pasa nada" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="750" y="790" width="240" height="70" as="geometry" /></mxCell><mxCell id="fb0" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1040" y="798" width="54" height="54" as="geometry" /></mxCell><mxCell id="pb2" value="El panel derecho cambia a «Extender duración» y oculta las acciones rápidas" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1050" y="610" width="250" height="100" as="geometry" /></mxCell><mxCell id="ab2" value="Elige los meses (6, 12, 24, 36 u otro); si quiere fija un nuevo inicio; desmarca contratos de la lista" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1350" y="595" width="280" height="130" as="geometry" /></mxCell><mxCell id="sb1" value="Muestra «Lo que va a cambiar»: duración, término y estado, antes y después" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1680" y="610" width="300" height="100" as="geometry" /></mxCell><mxCell id="ab3" value="Presiona «Extender N contrato(s)»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1680" y="900" width="300" height="80" as="geometry" /></mxCell><mxCell id="sb2" value="Duración + meses; término = inicio + duración; conserva el ID. Si estaba Vencido vuelve a Vigente y se recalcula la Etapa de gestión" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1330" y="880" width="300" height="120" as="geometry" /></mxCell><mxCell id="sb3" value="Guarda por ID con copia de seguridad e historial y avisa a las demás pantallas" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="890" width="270" height="100" as="geometry" /></mxCell><mxCell id="pb3" value="Mensaje «Se renovó N contrato(s)» y la tabla se actualiza" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="890" width="270" height="100" as="geometry" /></mxCell><mxCell id="fb" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="903" width="54" height="54" as="geometry" /></mxCell><mxCell id="notas" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• «Marcar como Vencido» solo corrige Vigente o Activación pendiente con término pasado. No toca Baja, Baja solicitada ni Revisar: son decisiones de negocio ya tomadas, no olvidos.&lt;br&gt;• En el panel actúa solo sobre las filas seleccionadas; el botón de la barra actúa sobre toda la cartera. Con 0 pendientes el botón queda gris y avisa que no hay unidades. Ninguno pide confirmación.&lt;br&gt;• «Marcar como Vigente» es el caso inverso: unidades ya Conectadas en Volvo Connect que seguían en Activación pendiente pasan a Vigente. Actúa sobre toda la bandeja visible.&lt;br&gt;• «Extender duración» solo sirve con estado Vigente o Vencido, duración numérica (no MENSUAL ni «-») y fecha de inicio. Las filas que no cumplen se dejan igual y el panel lo avisa.&lt;br&gt;• Extender no crea contrato nuevo: mantiene el ID y los datos. Para cambiar condiciones se usa «Renovar contrato» (ver el diagrama Renovar contratos)." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#9E9E9E;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="1130" width="1750" height="190" as="geometry" /></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ia" target="pa1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pa1" target="sa1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sa1" target="da"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f4" value="Selección" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="da" target="aa1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f5" value="Toda la cartera" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="da" target="aa2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.3;entryY=0;" edge="1" parent="1" source="aa1" target="sa2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.3;entryY=1;" edge="1" parent="1" source="aa2" target="sa2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sa2" target="sa3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sa3" target="fa"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ib" target="pb1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pb1" target="ab1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ab1" target="db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f13" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="db" target="sb0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sb0" target="fb0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f15" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="db" target="pb2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pb2" target="ab2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ab2" target="sb1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sb1" target="ab3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="ab3" target="sb2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="sb2" target="sb3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="sb3" target="pb3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="f22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" 