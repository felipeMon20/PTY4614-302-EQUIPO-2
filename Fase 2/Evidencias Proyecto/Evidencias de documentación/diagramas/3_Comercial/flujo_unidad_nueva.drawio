<mxfile host="app.diagrams.net"><diagram id="unidad-nueva" name="Unidad nueva"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="titulo" value="&lt;b style=&quot;font-size:20px&quot;&gt;Unidad nueva: paso a paso&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot;&gt;Desde que llega una unidad hasta que queda conectada y vigente&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="-130" width="700" height="50" as="geometry" /></mxCell><mxCell id="ley0" value="Pantalla" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="760" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley1" value="Acción del usuario" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="925" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley2" value="Sistema" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley3" value="Fuera de la app" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;dashed=1;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1255" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley_dec" value="Decisión" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="-130" width="110" height="46" as="geometry" /></mxCell><mxCell id="ley_ini" value="INICIO" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#60a917;strokeColor=#2D7600;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1550" y="-134" width="54" height="54" as="geometry" /></mxCell><mxCell id="ley_fin" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1615" y="-134" width="54" height="54" as="geometry" /></mxCell><mxCell id="carril_com" value="Comercial" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=16;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="40" height="540" as="geometry" /></mxCell><mxCell id="fondo_com" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F6FBF5;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="60" width="2010" height="540" as="geometry" /></mxCell><mxCell id="carril_ope" value="Operaciones" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="40" height="380" as="geometry" /></mxCell><mxCell id="fondo_ope" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F9FE;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="640" width="2010" height="380" as="geometry" /></mxCell><mxCell id="ini" value="INICIO" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#60a917;strokeColor=#2D7600;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="108" width="54" height="54" as="geometry" /></mxCell><mxCell id="a1" value="Comercial › Unidad nueva" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="180" y="100" width="190" height="70" as="geometry" /></mxCell><mxCell id="a2" value="¿Importar Excel de Power BI?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410" y="85" width="190" height="100" as="geometry" /></mxCell><mxCell id="s1" value="Elige el Excel de Notas de Venta (hoja Export)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="200" height="70" as="geometry" /></mxCell><mxCell id="s2" value="Lee RUT, razón social, ejecutivo, VIN, modelo y CDB de cada fila" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="920" y="100" width="220" height="70" as="geometry" /></mxCell><mxCell id="s3" value="Descarta los VIN ya existentes (los dados de baja se avisan), repetidos y sin VIN" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="100" width="230" height="70" as="geometry" /></mxCell><mxCell id="s4" value="Resumen y confirmación" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1450" y="100" width="190" height="70" as="geometry" /></mxCell><mxCell id="n1" value="Rellena el formulario (obligatorios: RUT, razón social y VIN)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="230" width="200" height="70" as="geometry" /></mxCell><mxCell id="n2" value="El chasis (últimos 7 del VIN) y el modelo se completan al ingresar el VIN" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="920" y="230" width="220" height="70" as="geometry" /></mxCell><mxCell id="n3" value="Presiona Guardar" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="230" width="230" height="70" as="geometry" /></mxCell><mxCell id="m1" value="Guarda con valores iniciales:&lt;br&gt;&lt;b&gt;Revisar · No aplica · Sin contrato · Sin registro&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1700" y="175" width="260" height="90" as="geometry" /></mxCell><mxCell id="b1" value="Comercial › Nuevas oportunidades" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1730" y="380" width="200" height="70" as="geometry" /></mxCell><mxCell id="b2" value="¿El cliente toma el servicio?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1440" y="365" width="190" height="100" as="geometry" /></mxCell><mxCell id="b3" value="Editar unidad" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1190" y="380" width="190" height="70" as="geometry" /></mxCell><mxCell id="b4" value="Abre el formulario en edición. Operaciones queda de solo lectura; si es Sin contrato / Sin registro, fuerza Activación pendiente y Activando" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="360" width="250" height="110" as="geometry" /></mxCell><mxCell id="b5" value="Completa Comercial y JustTime &amp;amp; CM (la forma de contrato debe ser distinta de Sin contrato)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="375" width="220" height="80" as="geometry" /></mxCell><mxCell id="b6" value="Presiona Guardar" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="410" y="380" width="170" height="70" as="geometry" /></mxCell><mxCell id="b7" value="La unidad pasa a Operaciones › Activaciones" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="180" y="380" width="190" height="70" as="geometry" /></mxCell><mxCell id="p1" value="Enviar a papelera (solo unidades SIN VC)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1440" y="505" width="190" height="60" as="geometry" /></mxCell><mxCell id="fin1" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1680" y="508" width="54" height="54" as="geometry" /></mxCell><mxCell id="c1" value="Operaciones › Activaciones" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="180" y="700" width="190" height="70" as="geometry" /></mxCell><mxCell id="c2" value="Busca el VIN en ISOS (conectividad de Volvo Connect)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;dashed=1;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="410" y="700" width="210" height="70" as="geometry" /></mxCell><mxCell id="c3" value="¿Existe en Volvo Connect?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="685" width="190" height="100" as="geometry" /></mxCell><mxCell id="c4" value="Conecta la unidad en Volvo Connect" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;dashed=1;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="890" y="700" width="200" height="70" as="geometry" /></mxCell><mxCell id="c5" value="Marcar como CONECTADO (CDB flota y Flota VC obligatorios)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1130" y="700" width="220" height="70" as="geometry" /></mxCell><mxCell id="c6" value="Elige la fecha de activación en Volvo Connect: es el inicio del contrato" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1390" y="700" width="230" height="70" as="geometry" /></mxCell><mxCell id="c7" value="Activación = Conectado y Estado comercial = Vigente. El término se calcula con la duración" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1660" y="690" width="250" height="90" as="geometry" /></mxCell><mxCell id="c8" value="Comercial › Renovar contratos" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1660" y="840" width="250" height="70" as="geometry" /></mxCell><mxCell id="fin2" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1950" y="848" width="54" height="54" as="geometry" /></mxCell><mxCell id="d1" value="Marcar como SIN FLOTA" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="870" width="190" height="70" as="geometry" /></mxCell><mxCell id="d2" value="Activación = Sin flota. Si Flota VC estaba vacía, queda «NO EXISTE EN VC»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="890" y="860" width="230" height="90" as="geometry" /></mxCell><mxCell id="d3" value="Operaciones › Sin Flota" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="870" width="190" height="70" as="geometry" /></mxCell><mxCell id="d4" value="La unidad aparece en Volvo Connect" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;dashed=1;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1390" y="870" width="230" height="70" as="geometry" /></mxCell><mxCell id="notas" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• Una unidad creada a mano o importada queda siempre en Nuevas oportunidades, con los mismos valores iniciales.&lt;br&gt;• Importación: la razón social y el CDB se toman de lo ya registrado para ese RUT; el ejecutivo se busca en el directorio de ejecutivos. Nada se guarda hasta confirmar el resumen.&lt;br&gt;• El ejecutivo no es obligatorio: vacío se guarda como «Desconocido».&lt;br&gt;• Desde Sin Flota también se marca como CONECTADO: se exigen CDB flota y Flota VC, y se pide la fecha de activación igual que en Activaciones.&lt;br&gt;• ISOS está fuera de este proyecto. La app no se comunica con Volvo Connect: Operaciones marca a mano el resultado." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#9E9E9E;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="1050" width="1300" height="150" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ini" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a2" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="a2" target="n1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBac