<mxfile host="app.diagrams.net"><diagram id="contratos-cm" name="Contratos CM"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1650" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="titulo" value="&lt;b style=&quot;font-size:20px&quot;&gt;Contratos CM: de la carga mensual a la baja del CM&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot;&gt;Cómo se importa el Excel de 3PC, cuándo se abre un caso de revisión y qué hace Comercial con él&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="-130" width="900" height="50" as="geometry" /></mxCell><mxCell id="ley0" value="Pantalla" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley1" value="Acción del usuario" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1125" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley2" value="Sistema" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1290" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley3" value="Fuera de la app" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;dashed=1;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1455" y="-125" width="150" height="36" as="geometry" /></mxCell><mxCell id="ley_dec" value="Decisión" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1620" y="-130" width="110" height="46" as="geometry" /></mxCell><mxCell id="ley_ini" value="INICIO" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#60a917;strokeColor=#2D7600;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1750" y="-134" width="54" height="54" as="geometry" /></mxCell><mxCell id="ley_fin" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1815" y="-134" width="54" height="54" as="geometry" /></mxCell><mxCell id="carril_imp" value="Contratos (CM)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="40" height="470" as="geometry" /></mxCell><mxCell id="fondo_imp" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F9FE;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="40" width="2010" height="470" as="geometry" /></mxCell><mxCell id="carril_aut" value="Casos de revisión" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=16;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="40" height="310" as="geometry" /></mxCell><mxCell id="fondo_aut" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FAF7FC;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="540" width="2010" height="310" as="geometry" /></mxCell><mxCell id="carril_com" value="Comercial" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=16;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="40" height="460" as="geometry" /></mxCell><mxCell id="fondo_com" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F6FBF5;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="880" width="2010" height="460" as="geometry" /></mxCell><mxCell id="i1" value="INICIO" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#60a917;strokeColor=#2D7600;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="98" width="54" height="54" as="geometry" /></mxCell><mxCell id="p1" value="Contratos (CM)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="170" y="90" width="160" height="70" as="geometry" /></mxCell><mxCell id="f1" value="Descarga el Excel mensual de contratos 3PC" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;dashed=1;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="365" y="85" width="190" height="80" as="geometry" /></mxCell><mxCell id="a1" value="Presiona «Importar Excel CM» y elige el archivo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="590" y="85" width="180" height="80" as="geometry" /></mxCell><mxCell id="s1" value="Lee VIN, N° de contrato 3PC, fechas, estado, tipo, pago y cliente. Compara con los contratos actuales del Registro Maestro" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="810" y="65" width="230" height="120" as="geometry" /></mxCell><mxCell id="p2" value="Resumen de la importación" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="85" width="200" height="80" as="geometry" /></mxCell><mxCell id="a2" value="Confirma" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1320" y="90" width="150" height="70" as="geometry" /></mxCell><mxCell id="d1" value="¿El VIN está en el Registro Maestro?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1510" y="75" width="210" height="100" as="geometry" /></mxCell><mxCell id="s4" value="VIN que viene en el Excel pero no tiene ficha: se lista para vincular" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1770" y="65" width="280" height="120" as="geometry" /></mxCell><mxCell id="d2" value="¿El contrato actual está en Baja?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1510" y="225" width="210" height="100" as="geometry" /></mxCell><mxCell id="s2" value="Actualiza los datos de CM del contrato actual. Gold, Blue o Silver fijan la forma CMG, CMB o CMS y la facturación CM (si la forma no era otra). Si el CM pasa a Expired, Estado comercial = Revisar" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1100" y="205" width="350" height="140" as="geometry" /></mxCell><mxCell id="a3" value="Elige el cliente en «Vincular con Comercial (RM)»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1790" y="240" width="240" height="70" as="geometry" /></mxCell><mxCell id="s3" value="El contrato en baja no se toca. Si el CM llega Expired y la unidad admite otro contrato, se crea uno nuevo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1465" y="360" width="300" height="120" as="geometry" /></mxCell><mxCell id="s5" value="Crea la ficha con los datos de CM (Revisar, No aplica). Sin coincidencia queda sin cliente para revisar" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1790" y="360" width="240" height="120" as="geometry" /></mxCell><mxCell id="c1" value="Los VIN con CM (que no estén en Terminated) y no vinieron en el Excel generan un caso «Ausente de 3PC» (suma un mes de ausencia). Se guardan antes de confirmar. Un VIN ausente no confirma baja" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="780" y="585" width="290" height="130" as="geometry" /></mxCell><mxCell id="c2" value="Los contratos con Estado del CM = Expired generan un caso «Contrato expirado». También al guardar una edición" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1140" y="585" width="270" height="130" as="geometry" /></mxCell><mxCell id="c3" value="Guarda los casos pendientes en CasosBajaCM.csv. Si el VIN ya tiene un caso abierto, solo se actualiza" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="750" width="300" height="80" as="geometry" /></mxCell><mxCell id="p3" value="Comercial › Oportunidades CM: casos pendientes con su motivo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1000" y="930" width="220" height="90" as="geometry" /></mxCell><mxCell id="g1" value="Selecciona las unidades (puede ser varias)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1260" y="940" width="190" height="80" as="geometry" /></mxCell><mxCell id="d3" value="¿Corresponde dar de baja el CM?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1490" y="925" width="230" height="110" as="geometry" /></mxCell><mxCell id="g2" value="Presiona «Confirmar baja»" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1770" y="940" width="270" height="80" as="geometry" /></mxCell><mxCell id="sb" value="El contrato pasa a Baja y el Estado del CM a Terminated. Los datos del CM se conservan como historial. El caso queda CONFIRMADA_BAJA y sale de la bandeja" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1755" y="1085" width="300" height="120" as="geometry" /></mxCell><mxCell id="ob" value="Operaciones › Bajas: desconectan la unidad" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1755" y="1250" width="300" height="70" as="geometry" /></mxCell><mxCell id="g3" value="Envía el correo «Aviso de Vencimiento» desde el Gestor de Correos" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1490" y="1100" width="230" height="80" as="geometry" /></mxCell><mxCell id="fr" value="El cliente renueva el CM en 3PC: llega en el próximo Excel" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ECEFF1;strokeColor=#607D8B;dashed=1;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1190" y="1100" width="230" height="80" as="geometry" /></mxCell><mxCell id="sc" value="El caso se cierra solo (REAPARECIDO) cuando el VIN vuelve al Excel o el CM deja de estar Expired" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="1090" width="250" height="100" as="geometry" /></mxCell><mxCell id="fin" value="FIN" style="ellipse;aspect=fixed;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e51400;strokeColor=#B20000;fontColor=#FFFFFF;fontStyle=1;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="790" y="1113" width="54" height="54" as="geometry" /></mxCell><mxCell id="notas" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• Que un VIN desaparezca del Excel no confirma una baja: su fila en el Registro Maestro no se toca. Solo abre un caso para revisarlo.&lt;br&gt;• El caso también se cierra como CONTRATO CERRADO si el contrato terminó sin pendientes o fue reemplazado por otro.&lt;br&gt;• La forma de contrato solo se pisa si estaba vacía, en Sin contrato o ya era CMG, CMB o CMS: una Venta, Conversión o Provisión no se cambia.&lt;br&gt;• Poner Estado del CM = Terminated, a mano o con «Confirmar baja», no borra los datos del CM. Una unidad con CM en Terminated no vuelve a generar casos de ausencia.&lt;br&gt;• En Oportunidades CM también están «Editar unidad», «Exportar lista» (Excel de casos pendientes) y «Enviar correo», con «Aviso de Vencimiento» ya elegida. «Confirmar baja» es exclusiva de esta pestaña.&lt;br&gt;• Contratos (CM) muestra solo las unidades con N° de contrato 3PC y sin contrato en Baja. «Limpiar datos de CM» deja en «-» los datos de CM de las unidades cuya forma de contrato y facturación no son de CM." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F5F7FA;strokeColor=#9E9E9E;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="20" y="1370" width="1700" height="190" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="i1" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1" target="f1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f1" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a1" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a2" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geom