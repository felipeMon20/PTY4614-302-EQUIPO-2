            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="titulo" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;" value="&lt;b style=&quot;font-size:20px&quot;&gt;Gestor de Correos: cómo funciona hoy&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot;&gt;Desde que se abre hasta que los borradores quedan en Outlook&lt;/font&gt;" vertex="1">
                    <mxGeometry height="50" width="560" x="20" y="-130" as="geometry"/>
                </mxCell>
                <mxCell id="nota_entrada" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;dashed=1;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#5D4037;align=left;spacing=10;" value="&lt;b&gt;Dónde se abre:&lt;/b&gt; desde Comercial (Gestionar CM › Enviar correo, con los VIN y la plantilla ya elegidos), desde General (por VIN) o directo. Si falta algún VIN en Correos.csv, Comercial avisa y ofrece abrir el Gestor para sincronizar primero." vertex="1">
                    <mxGeometry height="85" width="620" x="720" y="-140" as="geometry"/>
                </mxCell>
                <mxCell id="zona_sync" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#D79B00;dashed=1;strokeWidth=1.5;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=13;spacing=6;" value="&lt;b&gt;Sincronizar BBDD Correos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#8A5A00&quot;&gt;Solo a mano, nunca se dispara sola&lt;/font&gt;" vertex="1">
                    <mxGeometry height="710" width="250" x="170" y="130" as="geometry"/>
                </mxCell>
