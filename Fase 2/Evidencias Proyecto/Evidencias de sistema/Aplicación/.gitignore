app_config.json
src/tests/app_config.json
.env
.env.*
*.pem
*.key
*.pfx
*.p12
credentials*.json
secrets*.json
token*.json

# Estado interno de Obsidian y de Claude Code (permisos y proyectos locales)
docs/.obsidian/
.claude/
CLAUDE.md

# ===== Datos reales de negocio =====
# Excel/CSV generados o sincronizados en runtime, copias de seguridad y cachés de la app
data/
Respaldo*/
*_backup_*
*.bak

# Documentos y entregables de calidad / DUOC (incluye presentaciones, planes y reportes)
duoc/

# Prototipo de base de datos descartado (SQLite con datos reales)
prototipo_db/

# Cualquier archivo de datos suelto, salvo las plantillas que usa el código
*.xlsx
*.xlsm
*.xls
*.csv
*.pptx
*.sqlite
*.sqlite3
*.db
*.pkl
!src/services/templates/**

# Contactos reales (nombres, correos, flotas) persistidos por la app
config/pinned_contacts.json
config/recent_recipients.json

# ===== Logs y temporales =====
# Pueden contener rutas, nombres y volúmenes de datos reales
logs/
src/tests/logs/
*.log
*.tmp
~$*
.~lock.*

# Datos mock generados al ejecutar los tests (no versionados, ver CLAUDE.md)
src/tests/mock_data/

